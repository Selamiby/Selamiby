{
    "backup": {
        "paths": [
            "~/Documents",
            "~/Desktop",
            "~/Pictures"
        ],
        "destination": "./backups",
        "compression": true,
        "compression_level": 6,
        "encryption": false,
        "verify_backup": true,
        "exclude_patterns": [
            "*.tmp",
            "*.log",
            "*.cache",
            "Thumbs.db",
            ".DS_Store"
        ],
        "exclude_dirs": [
            "node_modules",
            "__pycache__",
            ".git",
            ".venv",
            ".cache"
        ],
        "max_file_size_mb": 100,
        "follow_symlinks": false
    },
    "retention": {
        "max_backups": 30,
        "max_age_days": 90,
        "keep_daily": 7,
        "keep_weekly": 4,
        "keep_monthly": 3
    },
    "schedule": {
        "enabled": true,
        "interval_hours": 24,
        "time": "02:00",
        "day_of_week": "*",
        "day_of_month": "*"
    },
    "notifications": {
        "enabled": false,
        "email": "",
        "telegram_bot_token": "",
        "telegram_chat_id": "",
        "webhook_url": ""
    },
    "performance": {
        "max_threads": 4,
        "chunk_size_mb": 10,
        "buffer_size": 8192
    }
}