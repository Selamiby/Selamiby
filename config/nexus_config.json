{
    "system": {
        "name": "AETHEROS",
        "version": "2.0.0",
        "environment": "development",
        "debug": true,
        "log_level": "INFO",
        "heartbeat_interval": 30,
        "auto_recover": true,
        "max_errors": 10,
        "data_directory": "./data",
        "log_directory": "./logs",
        "backup_directory": "./backups"
    },
    "modules": {
        "backup_manager": {
            "enabled": true,
            "auto_start": true,
            "config_file": "config/backup_config.json"
        },
        "system_monitor": {
            "enabled": true,
            "auto_start": true,
            "log_interval": 60,
            "alert_thresholds": {
                "cpu_warning": 80,
                "cpu_critical": 95,
                "memory_warning": 85,
                "memory_critical": 95,
                "disk_warning": 80,
                "disk_critical": 90
            }
        },
        "file_organizer": {
            "enabled": true,
            "auto_start": false,
            "watch_paths": [
                "~/Downloads",
                "~/Desktop"
            ],
            "organize_interval": 300
        }
    },
    "api": {
        "enabled": true,
        "host": "0.0.0.0",
        "port": 8000,
        "cors_origins": [
            "*"
        ],
        "rate_limit": {
            "enabled": true,
            "max_requests": 100,
            "time_window": 60
        },
        "authentication": {
            "enabled": false,
            "jwt_secret": "change-this-in-production",
            "token_expiry": 3600
        }
    },
    "telemetry": {
        "enabled": true,
        "collect_metrics": true,
        "collect_logs": true,
        "privacy_mode": false
    }
}