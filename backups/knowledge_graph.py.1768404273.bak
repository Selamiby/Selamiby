import numpy as npimport networkx as nxclass HybridKnowledgeGraph:    def __init__(self):        self.graph = nx.DiGraph()        self.matrix = np.zeros((10000, 10000))    def add_entity(self, entity):        self.graph.add_node(entity)        self.matrix[entity, entity] = 1    def add_relation(self, entity1, entity2):        self.graph.add_edge(entity1, entity2)        self.matrix[entity1, entity2] = 1    def query(self, entity):        # Perform graph-based query        graph_result = nx.ancestors(self.graph, entity)        # Perform matrix-based query        matrix_result = np.where(self.matrix[entity] == 1)[0]        # Combine results        result = graph_result.union(matrix_result)        return result    def update(self, entity, new_info):        # Update graph        self.graph.nodes[entity]['info'] = new_info        # Update matrix        self.matrix[entity, entity] = 1# Example usage:hkg = HybridKnowledgeGraph()hkg.add_entity('entity1')hkg.add_relation('entity1', 'entity2')print(hkg.query('entity1'))hkg.update('entity1', 'new_info')print(hkg.query('entity1'))