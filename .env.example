# AETHEROS Environment Variables
# Copy this file to .env and update values

# System
AETHEROS_ENV=development
AETHEROS_DEBUG=true
AETHEROS_LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-in-production

# Database (if used)
# DATABASE_URL=sqlite:///./data/aetheros.db

# External Services
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# Security
ENCRYPTION_KEY=change-this-in-production
JWT_SECRET=change-this-in-production

# Paths
DATA_DIR=./data
LOG_DIR=./logs
BACKUP_DIR=./backups
